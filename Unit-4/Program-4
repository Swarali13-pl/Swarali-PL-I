#include <stdio.h>

int main()
{
    char str[100];
    int i, length = 0;

    printf("Enter a string: ");
    scanf("%s", str);

    /* Find length */
    while(str[length] != '\0')
    {
        length++;
    }

    printf("Length of string = %d\n", length);

    /* Reverse string */
    printf("Reverse of string = ");

    for(i = length - 1; i >= 0; i--)
    {
        printf("%c", str[i]);
    }

    printf("\n");

    return 0;
}
