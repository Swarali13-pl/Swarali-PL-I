#include <stdio.h>

int main()
{
    int num = 25;
    int *ptr;

    ptr = &num;

    printf("Using variable:\n");
    printf("Value = %d\n", num);
    printf("Address = %p\n", (void *)&num);

    printf("\nUsing pointer:\n");
    printf("Value = %d\n", *ptr);
    printf("Address = %p\n", (void *)ptr);

    return 0;
}
